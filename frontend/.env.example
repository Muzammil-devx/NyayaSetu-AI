# Browser-visible Firebase client configuration (not server credentials).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Leave blank for a same-origin /api backend. For local Vite development,
# the development proxy target defaults to http://127.0.0.1:8000.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=
